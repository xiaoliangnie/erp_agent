# Copy this file to .env and fill values only on the deployment machine.

# Service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8777
APP_BASE_URL=http://127.0.0.1:8777
APP_SESSION_SECRET=replace-with-a-long-random-value
LOG_LEVEL=INFO

# Local writable mirror. API credentials below maintain this database incrementally.
REALTIME_DATABASE_ENV_FILE=hanli.env
REALTIME_SYNC_ENABLED=false
SUPPLY_API_BASE=https://api.wjyfek.com
SUPPLY_API_CLIENT_ID=
SUPPLY_API_CLIENT_SECRET=
SUPPLY_API_CLIENT_SECRET_FILE=
REALTIME_SYNC_INTERVAL_SECONDS=60
REALTIME_SYNC_INITIAL_DELAY_SECONDS=30
REALTIME_SYNC_INITIAL_DAYS=30
REALTIME_SYNC_OVERLAP_MINUTES=5
REALTIME_SYNC_CHUNK_DAYS=7
REALTIME_SYNC_PAGE_SIZE=50
REALTIME_SYNC_REQUEST_INTERVAL=1.05
REALTIME_SYNC_TIMEOUT_SECONDS=45
# 同步源：订单/采购单/商品/供应商；商品和供应商使用同一限流配置。

# 国家标准目录（std.samr.gov.cn 高级检索 JSON）。只同步目录元数据，不下载标准全文。
# 默认按商品表 realtime_products.category 展开 config/gb_category_map.json 里的目录族。
# filtered 才使用下面的 CCS/ICS/关键字；全量约 8 万条用 GB_SYNC_SCOPE=all。
GB_SYNC_ENABLED=false
GB_SYNC_SCOPE=products
GB_SYNC_CATEGORY_MAP=config/gb_category_map.json
GB_SYNC_CCS=
GB_SYNC_ICS=
GB_SYNC_KEYWORDS=
GB_SYNC_STATUS=
GB_SYNC_TIME=02:30
GB_SYNC_INITIAL_DELAY_SECONDS=60
GB_SYNC_PAGE_SIZE=50
GB_SYNC_REQUEST_INTERVAL=1.2
GB_SYNC_TIMEOUT_SECONDS=30
GB_SYNC_MAX_PAGES=0

# Purchase contract workbook runtime. Point to the artifact-tool entry file supplied
# by the deployment runtime; do not rely on global Node module resolution.
CONTRACT_NODE=
CONTRACT_ARTIFACT_TOOL_PATH=
CONTRACT_SOFFICE=
CONTRACT_PDFTOPPM=
CONTRACT_FONTCONFIG_FILE=

# Agent / LLM. Default is any OpenAI-compatible endpoint (DeepSeek / 通义 / Kimi).
AGENT_ENABLED=false
AGENT_PROVIDER=openai_compatible
AGENT_MODEL=
AGENT_API_BASE=
AGENT_API_KEY=
# Codex OAuth（和 OpenClaw 同一条路）：AGENT_PROVIDER=codex_oauth 后不需要 API Key，
# 复用本机 ~/.codex/auth.json 的 ChatGPT 登录，走 chatgpt.com/backend-api/codex/responses。
# AGENT_MODEL 改成当前 ChatGPT 账号在 Codex 里能用的名字（本机列表见
# chatgpt.com/backend-api/codex/models）。2026-08 这台机器上是 gpt-5.6-sol，
# 不要填已对 ChatGPT 登录下线的 gpt-5.3-codex。
AGENT_CODEX_AUTH_FILE=
AGENT_CODEX_ORIGINATOR=codex_cli_rs
AGENT_TEMPERATURE=0.1
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_TOOL_STEPS=8
AGENT_HISTORY_LIMIT=20
AGENT_ACTION_TTL_SECONDS=1800
AGENT_API_TOKEN=replace-with-a-long-random-value
# Agent business database (sessions, runs, tool executions, pending actions, audit)
AGENT_DATABASE_PATH=data/agent.sqlite3

# Demand forecasting. Model artifacts are written by scripts/train_forecast_model.py.
FORECAST_MODEL_DIR=data/models
FORECAST_LEAD_TIME_DAYS=15
FORECAST_BUFFER_DAYS=3
FORECAST_SERVICE_LEVEL=0.9
FORECAST_HORIZON_DAYS=30
# Sales and inventory tables are not in the realtime database yet. Fill these in when
# they land; until then train from a CSV export (--csv) and pass inventory explicitly.
FORECAST_SALES_TABLE=
FORECAST_SALES_KEY_COLUMN=sku_id
FORECAST_SALES_DATE_COLUMN=io_date
FORECAST_SALES_QTY_COLUMN=qty
FORECAST_SALES_STATUS_COLUMN=
FORECAST_INVENTORY_TABLE=
FORECAST_INVENTORY_KEY_COLUMN=sku_id
FORECAST_INVENTORY_QTY_COLUMN=qty

# Order SKU exchange. Keep the browser worker token separate from the web/operator token.
EXCHANGE_API_TOKEN=replace-with-a-long-random-value
EXCHANGE_WORKER_TOKEN=replace-with-another-long-random-value
EXCHANGE_DATABASE_PATH=data/exchange_jobs.sqlite3
# Order-picker source populated by the API mirror.
EXCHANGE_ORDER_DATABASE_ENV_FILE=hanli.env
EXCHANGE_ORDER_TABLE=realtime_orders
EXCHANGE_ORDER_ID_COLUMN=o_id
EXCHANGE_ORDER_PLATFORM_ID_COLUMN=so_id
EXCHANGE_ORDER_DATE_COLUMN=order_date
EXCHANGE_ORDER_STATUS_COLUMN=status
EXCHANGE_ORDER_SHOP_COLUMN=shop_name
EXCHANGE_ORDER_BUYER_COLUMN=buyer_name
EXCHANGE_ORDER_ITEM_TABLE=realtime_order_items
EXCHANGE_ORDER_ITEM_ORDER_ID_COLUMN=o_id
EXCHANGE_ORDER_ITEM_SKU_COLUMN=sku_id
EXCHANGE_ORDER_ITEM_STYLE_COLUMN=i_id
EXCHANGE_ORDER_ITEM_NAME_COLUMN=name
EXCHANGE_ORDER_ITEM_PROPERTIES_COLUMN=properties_value
EXCHANGE_ORDER_ITEM_QTY_COLUMN=qty
PRODUCT_IMAGE_DATABASE_PATH=data/product_image_jobs.sqlite3
PRODUCT_IMAGE_CACHE_DIR=data/product-images

# DingTalk application robot (recommended: Stream mode; needs `pip install dingtalk-stream`)
DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=
# Target group for scheduled reminders. The app robot can @ by userId; a webhook robot
# can only @ by mobile number.
DINGTALK_GROUP_CONVERSATION_ID=

# Daily delivery reminder push. Independent of the LLM - can be enabled on its own.
DINGTALK_REMINDER_ENABLED=false
DINGTALK_REMINDER_TIME=08:30
DINGTALK_REMINDER_LIMIT=200
DINGTALK_REMINDER_TITLE=采购交期催办
DINGTALK_REMINDER_AT_ALL=false

# Optional HTTP callback/custom webhook settings
DINGTALK_CALLBACK_TOKEN=
DINGTALK_CALLBACK_AES_KEY=
DINGTALK_WEBHOOK_URL=
DINGTALK_WEBHOOK_SECRET=
